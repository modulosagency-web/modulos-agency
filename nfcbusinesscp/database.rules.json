{
  "rules": {
    ".read": false,
    ".write": false,

    "businesses": {
      ".read": "auth != null && auth.token.email === 'geeky1934@gmail.com' && auth.token.email_verified === true",
      ".write": "auth != null && auth.token.email === 'geeky1934@gmail.com' && auth.token.email_verified === true",
      "$cardId": {
        ".read": "root.child('status').child($cardId).child('active').val() === true",
        ".validate": "newData.hasChildren(['cardId','name','description','active','createdAt'])",
        "cardId": { ".validate": "newData.isString() && newData.val() === $cardId && newData.val().matches(/^[0-9]{4,9}$/)" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "logo": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "whatsapp": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "instagram": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "facebook": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "youtube": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "googleReview": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "location": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "active": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "status": {
      "$cardId": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'geeky1934@gmail.com' && auth.token.email_verified === true",
        ".validate": "$cardId.matches(/^[0-9]{4,9}$/) && newData.hasChild('active')",
        "active": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "settings": {
      ".read": "auth != null && auth.token.email === 'geeky1934@gmail.com' && auth.token.email_verified === true",
      ".write": "auth != null && auth.token.email === 'geeky1934@gmail.com' && auth.token.email_verified === true",
      "publicBaseUrl": { ".validate": "newData.isString() && newData.val().length <= 300" },
      "defaultActive": { ".validate": "newData.isBoolean()" },
      "idleMinutes": { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 240" },
      "$other": { ".validate": false }
    }
  }
}
