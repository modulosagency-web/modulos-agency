{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "database.rules.json", "README.txt", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/nfcbusinesscp/**", "destination": "/nfcbusinesscp/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]}
    ]
  }
}
